{
  "name": "signalpost-norwegian-company-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "agent:run": "tsx agent/run.ts",
    "signalpost": "tsx agent/run.ts",
    "test:agent": "tsx agent/test/selftest.ts",
    "check:signalpost": "tsc --noEmit && tsx agent/test/selftest.ts",
    "check:signalpost-showcase": "vite build",
    "check:signalpost-challenge": "tsx agent/run.ts examples/sample-orgnrs.txt out",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "description": "Signalpost agent: evidence-backed Norwegian company profiles from official Brønnøysund registers, one result envelope per organisation number."
}
