# Signalpost needs no API keys or secrets.
# Sources: the open Brønnøysundregistrene APIs (data.brreg.no), NAV's public job vacancy feed
# (pam-stilling-feed.nav.no, published public token) and company-owned websites (public pages,
# robots.txt honoured). All settings below are optional.

# Batch runner (agent/run.ts)
# SIGNALPOST_CONCURRENCY=8                 # parallel registry requests
# SIGNALPOST_MAX_REQUESTS=20000            # hard cap on registry requests per run
# SIGNALPOST_DEADLINE_SECONDS=0            # if > 0, unfinished companies are closed out at this time
# SIGNALPOST_STATE_DIR=.signalpost-state   # where refresh snapshots are kept between runs
# SIGNALPOST_MAX_LOCATION_PAGES=2          # sub-unit pages (100 each) per company

# Hiring (NAV job vacancy feed)
# SIGNALPOST_JOBS=on                       # off = job postings reported as not checked
# SIGNALPOST_JOBS_DAYS=60                  # days of feed history to read
# SIGNALPOST_JOBS_DETAIL_SCAN=on           # read every active ad and match by employer org number
# SIGNALPOST_JOBS_DETAIL_BUDGET_MS=300000  # time budget for that read
# SIGNALPOST_NAV_CONCURRENCY=12            # parallel NAV requests
# SIGNALPOST_NAV_TOKEN=                    # optional NAV-issued token (the public token is used otherwise)

# Company websites
# SIGNALPOST_WEB=on                        # off = website step reported as not checked
# SIGNALPOST_WEB_CONCURRENCY=24            # parallel website requests
# SIGNALPOST_WEBSITE_BUDGET_MS=20000       # time budget for one company's website step

# Web app (server.ts)
# SIGNALPOST_CORPUS=out/envelopes.jsonl
# PORT=3000
