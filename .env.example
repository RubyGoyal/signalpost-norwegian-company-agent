# Signalpost needs no API keys or secrets. All sources are open Brønnøysundregistrene APIs.
# Optional settings for the batch runner (agent/run.ts):
# SIGNALPOST_CONCURRENCY=8            # parallel registry requests
# SIGNALPOST_MAX_REQUESTS=20000       # hard cap on outbound requests per run
# SIGNALPOST_DEADLINE_SECONDS=0       # if > 0, unfinished companies are closed out as `failed` at this time
# SIGNALPOST_STATE_DIR=.signalpost-state   # where refresh snapshots are kept between runs
# SIGNALPOST_MAX_LOCATION_PAGES=2     # sub-unit pages (100 each) per company
# Web app (server.ts):
# SIGNALPOST_CORPUS=out/envelopes.jsonl
# PORT=3000
