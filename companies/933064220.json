here":"$.kapital"}]}]},{"key":"registered_address","title":"Addresses","state":"found","note":null,"facts":[{"label":"Business address","value":"Nattlandsveien 87C, 5094 BERGEN, Norge","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.forretningsadresse"}]}]},{"key":"industry","title":"Industry and purpose","state":"found","note":null,"facts":[{"label":"Industry code (NACE)","value":"68.120: Utvikling og salg av byggeprosjekter","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.naeringskode1"}]},{"label":"Institutional sector","value":"2100: Private aksjeselskaper mv.","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.institusjonellSektorkode"}]},{"label":"Registered purpose","value":"Å drive med eiendomsutvikling, spesielt med fokus på utvikling av tomter. Selskapet skal tilby tjenester innen arkitektur, byggesøknader og energirådgivning. Videre vil Boligplaner AS fungere som utførende totallentreprenør for å realisere prosjekter fra planleggingsfase til ferdigstillelse. Virksomhetsområde Eiendomsutvikling: Identifisering, kjøp og utvikling av eiendommer for bolig- eller næringsformål. Tomteutvikling: Utvikling av tomter inkluderer planlegging, opparbeidelse og infrastrukturtilrettelegging for fremtidig bygging. Arkitekttjenester: Tilby tjenester innenfor arkitektur, inkludert design av bygninger, utarbeidelse av tegninger og visualiseringer av fremtidige prosjekter. Byggesøknader: Håndtering av alle nødvendige byggesøknader og tillatelser nødvendig for gjennomføring av byggeprosjekter. Energirådgivning: Tilby rådgivningstjenester relatert til energieffektivitet, bærekraftige byggemetoder og bruk av fornybar energi i utviklingsprosjekter. Utførende totallentreprenør: Ta på seg ansvaret for gjennomføring av byggeprosjekter, inkludert koordinering av underleverandører, tidsplanlegging og kvalitetssikring av arbeidet.","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.vedtektsfestetFormaal"}]},{"label":"Registered activity","value":"Boligplaner AS er et fremtredende selskap i eiendomsutviklingsbransjen, med et spesialisert fokus på utvikling av tomter.","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.aktivitet"}]}]},{"key":"employees","title":"Employees","state":"found","note":null,"facts":[{"label":"Registered employees","value":"13","as_of":"2026-11-10","period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.antallAnsatte"}]}]},{"key":"status_flags","title":"Status","state":"found","note":null,"facts":[{"label":"Bankrupt","value":"No","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.konkurs"}]},{"label":"Under liquidation","value":"No","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (entity register)","url":"https://data.brreg.no/enhetsregisteret/api/enheter/933064220","retrieved_at":"2026-11-14T11:28:08.003Z","where":"$.underAvvikling"}]},{"label":"Under forced dissolution","value":"No","as_of":null,"period":null,"sources":[{"label":"Enhetsregisteret (en